# ── Database ─────────────────────────────────────────────────────────────────
# Pooled connection used by Prisma Client at runtime (Neon/Supabase pooler URL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&pgbouncer=true"

# Direct (non-pooled) connection used by Prisma Migrate and db:seed
# On Neon this is the same URL without ?pgbouncer=true
# On Supabase use the "Direct connection" string from the project dashboard
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ── Cron security ─────────────────────────────────────────────────────────────
# Random secret – Vercel sends this as Authorization: Bearer <secret>
# Generate with: openssl rand -hex 32
CRON_SECRET="replace-with-a-random-secret"

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# How long (minutes) a reservation is held before it expires
RESERVATION_WINDOW_MINUTES="10"
